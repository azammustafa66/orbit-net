# Local secrets. Gitignored — never commit this file.
# Regenerate the JWT secret with: openssl rand -base64 32
JWT_SECRET=generate-with-openssl-rand-base64-32
NEO4J_PASSWORD=choose-a-password

# Cloudinary — uploader-service will not start until these are real values.
# Copy them from wherever you currently export them in your shell.
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# Which image tag compose runs. Must match the <version> in the poms, and the images
# must already exist locally (mvn jib:dockerBuild -Prelease) or on Docker Hub.
IMAGE_TAG=0.1.0

# Host port overrides. Only needed when something else already binds these — the
# separate postgres-pgadmin project takes 5432 and 9092.
# POSTGRES_PORT=5442
# KAFKA_PORT=9192
